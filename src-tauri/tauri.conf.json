{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ASGAR Avia ",
  "version": "0.1.0",
  "identifier": "com.asgar.avia",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://10.82.26.48:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
  "windows": [
    {
      "title": "ASGAR Avia",
      "width": 800,
      "height": 600,
      "resizable": true,
      "fullscreen": false,
      "devtools": true
    }
  ],
  "security": {
    "csp": null,
    "dangerousDisableAssetCspModification": ["script-src"]
  }
},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
